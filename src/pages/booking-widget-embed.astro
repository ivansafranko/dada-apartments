<!doctype html>
<html lang="hr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Booking Embed</title>
    <style>
      html,
      body {
        margin: 0;
        padding: 0;
        background: #fff;
        font-family: "IBM Plex Sans", "Segoe UI", Roboto, Arial, sans-serif;
        overflow: hidden;
      }

      #wbproot {
        min-height: 1400px;
        overflow: hidden;
      }
    </style>
  </head>
  <body>
    <div id="wbproot" class="notranslate"></div>

    <script is:inline>
      (() => {
        const root = document.getElementById("wbproot");
        if (!root) return;

        const params = new URLSearchParams(window.location.search);
        const language = params.get("lang") === "en" ? "en" : "hr";
        const hotelId = params.get("hotelId") || "33781";
        const currency = params.get("currency") || "EUR";
        const frameId = params.get("frameId") || "";
        const origin = "https://booking.webbookingpro.com";

        window.wbpSettings = {
          hotelId,
          language,
          currency,
          showLogo: "0",
          showProperty: 0,
          showFooter: "0",
          darktheme: "0"
        };

        const preferredInnerHeight = () => {
          if (window.innerWidth < 640) return 2600;
          if (window.innerWidth < 1024) return 2200;
          return 1800;
        };

        const styleNestedFrame = () => {
          const nestedFrame = root.querySelector("iframe");
          if (!(nestedFrame instanceof HTMLIFrameElement)) return false;
          const minHeight = preferredInnerHeight();
          nestedFrame.setAttribute("scrolling", "no");
          nestedFrame.style.display = "block";
          nestedFrame.style.width = "100%";
          nestedFrame.style.maxWidth = "100%";
          nestedFrame.style.border = "0";
          nestedFrame.style.height = `${minHeight}px`;
          nestedFrame.style.minHeight = `${minHeight}px`;
          return true;
        };

        let rafId = 0;

        const syncHeightToParent = () => {
          if (!frameId) {
            return;
          }

          if (rafId !== 0) {
            return;
          }

          rafId = window.requestAnimationFrame(() => {
            rafId = 0;
            styleNestedFrame();

            const nestedFrame = root.querySelector("iframe");
            const nestedHeight =
              nestedFrame instanceof HTMLIFrameElement
                ? nestedFrame.getBoundingClientRect().height
                : 0;

            const contentHeight = Math.max(
              preferredInnerHeight(),
              document.documentElement.scrollHeight,
              document.body.scrollHeight,
              root.scrollHeight,
              nestedHeight + 40
            );

            window.parent?.postMessage(
              {
                type: "wbp-embed-height",
                frameId,
                height: Math.ceil(contentHeight)
              },
              window.location.origin
            );
          });
        };

        const startObservers = () => {
          styleNestedFrame();
          syncHeightToParent();

          const mutationObserver = new MutationObserver(() => {
            if (styleNestedFrame()) {
              syncHeightToParent();
            }
          });
          mutationObserver.observe(root, { childList: true, subtree: true });

          const resizeObserver = new ResizeObserver(syncHeightToParent);
          resizeObserver.observe(root);
          resizeObserver.observe(document.documentElement);

          window.addEventListener("resize", syncHeightToParent, { passive: true });
          window.addEventListener("load", syncHeightToParent, { passive: true });
        };

        const loadAssets = async () => {
          const response = await fetch(`${origin}/asset-manifest.json`);
          if (!response.ok) throw new Error("Could not load booking manifest");
          const data = await response.json();
          const entrypoints = Array.isArray(data?.entrypoints) ? data.entrypoints : [];

          for (const file of entrypoints) {
            if (typeof file !== "string") continue;
            const normalized = file.replace(/^\/+/, "");
            const assetUrl = `${origin}/${normalized}`;

            if (normalized.endsWith(".css")) {
              const link = document.createElement("link");
              link.rel = "stylesheet";
              link.href = assetUrl;
              document.head.appendChild(link);
              continue;
            }

            if (normalized.endsWith(".js")) {
              await new Promise((resolve, reject) => {
                const script = document.createElement("script");
                script.src = assetUrl;
                script.async = false;
                script.onload = () => resolve();
                script.onerror = () => reject(new Error(`Failed to load ${assetUrl}`));
                document.head.appendChild(script);
              });
            }
          }
        };

        loadAssets()
          .then(startObservers)
          .catch(() => {
            root.innerHTML = '<p style="margin: 0; padding: 12px 0; color: #7a1f1f; font-size: 14px;">Booking calendar could not be loaded.</p>';
          });
      })();
    </script>
  </body>
</html>
