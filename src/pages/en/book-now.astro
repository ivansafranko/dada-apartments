---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import BookingEmbedSection from "@/components/sections/BookingEmbedSection.astro";
import { LOCALES } from "@/data/locales";
import { BOOKING, SITE, SOCIALS } from "@/data/site";
import { buildOrganizationSchema, buildWebsiteSchema } from "@/lib/structured-data";

const locale = LOCALES.en;

const alternates = [
  { hreflang: "hr", path: "/book-now" },
  { hreflang: "en", path: "/en/book-now" },
  { hreflang: "x-default", path: "/book-now" }
] as const;

const structuredData = [
  buildWebsiteSchema("/en/book-now"),
  buildOrganizationSchema(),
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: locale.seo.book.title,
    description: locale.seo.book.description,
    url: `${SITE.url}/en/book-now`,
    inLanguage: "en"
  }
];
---

<BaseLayout
  locale="en"
  skipToContentLabel={locale.skipToContent}
  meta={{
    title: locale.seo.book.title,
    description: locale.seo.book.description,
    canonicalPath: "/en/book-now",
    locale: "en"
  }}
  alternates={alternates}
  structuredData={structuredData}
>
  <Fragment slot="header">
    <Header
      nav={locale.nav}
      brand="Apartmani Dada"
      active="book"
      switchHref="/book-now"
      switchLabel="HR"
      links={{
        home: "/en/",
        apartments: "/en/#apartments-title",
        about: "/en/#about-title",
        book: "/en/book-now",
        contact: "/en/#contact-title"
      }}
    />
  </Fragment>

  <section class="section-shell">
    <div class="book-now-shell">
      <h1 class="section-title">{locale.book.title}</h1>
      <p class="section-subtitle">{locale.book.intro}</p>
      <div class="mt-8">
        <BookingEmbedSection
          hotelId={BOOKING.hotelId}
          language="en"
          currency={BOOKING.currency}
          frameTitle={locale.book.title}
          loadLabel={locale.book.loadWidget}
          fallbackBookingUrl={BOOKING.fallbackUrl}
          fallbackCta={locale.book.fallbackCta}
        />
      </div>
    </div>
  </section>

  <Fragment slot="footer">
    <Footer
      brand="Apartmani Dada"
      text={locale.footer.text}
      copyright={locale.footer.copyright}
      facebookUrl={SOCIALS.facebook}
    />
  </Fragment>
</BaseLayout>
