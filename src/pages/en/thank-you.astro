---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import { LOCALES } from "@/data/locales";
import { SITE, SOCIALS } from "@/data/site";
import { buildOrganizationSchema, buildWebsiteSchema } from "@/lib/structured-data";

const locale = LOCALES.en;
const alternates = [
  { hreflang: "hr", path: "/thank-you" },
  { hreflang: "en", path: "/en/thank-you" },
  { hreflang: "x-default", path: "/thank-you" }
] as const;

const structuredData = [
  buildWebsiteSchema("/en/thank-you"),
  buildOrganizationSchema(),
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: locale.seo.thankYou.title,
    description: locale.seo.thankYou.description,
    url: `${SITE.url}/en/thank-you`,
    inLanguage: "en"
  }
];
---

<BaseLayout
  locale="en"
  skipToContentLabel={locale.skipToContent}
  meta={{
    title: locale.seo.thankYou.title,
    description: locale.seo.thankYou.description,
    canonicalPath: "/en/thank-you",
    locale: "en"
  }}
  alternates={alternates}
  structuredData={structuredData}
>
  <Fragment slot="header">
    <Header
      nav={locale.nav}
      brand="Apartmani Dada"
      switchHref="/thank-you"
      switchLabel="HR"
      links={{
        home: "/en/",
        apartments: "/en/#apartments-title",
        about: "/en/#about-title",
        book: "/en/book-now",
        contact: "/en/#contact-title"
      }}
    />
  </Fragment>

  <section class="section-shell">
    <div class="page-shell">
      <div class="surface-card max-w-2xl">
        <h1 class="section-title">{locale.thankYou.title}</h1>
        <p class="section-subtitle">{locale.thankYou.text}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/en/" class="btn-primary">{locale.thankYou.homeCta}</a>
          <a href="/en/book-now" class="btn-accent">{locale.thankYou.bookCta}</a>
        </div>
      </div>
    </div>
  </section>

  <Fragment slot="footer">
    <Footer
      brand="Apartmani Dada"
      text={locale.footer.text}
      copyright={locale.footer.copyright}
      facebookUrl={SOCIALS.facebook}
    />
  </Fragment>
</BaseLayout>
