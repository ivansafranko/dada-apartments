---
import ContactForm from "@/components/islands/ContactForm";
import { CONTACT } from "@/data/site";
import type { LocaleStrings } from "@/types/i18n";
import type { LocaleCode } from "@/types/seo";

interface Props {
  locale: LocaleCode;
  copy: LocaleStrings["contact"];
}

const { locale, copy } = Astro.props;
---

<section id="contact" class="section-shell">
  <div class="page-shell">
    <h2 id="contact-title" class="section-title scroll-mt-28">{copy.title}</h2>
    <p class="section-subtitle">{copy.subtitle}</p>

    <div class="mt-10 grid grid-cols-1 gap-6 lg:grid-cols-[2fr_1fr]">
      <ContactForm
        client:idle
        actionUrl={locale === "hr" ? "/thank-you" : "/en/thank-you"}
        labels={copy.labels}
        placeholders={copy.placeholders}
        validation={copy.validation}
      />

      <aside class="surface-card space-y-6">
        <div class="flex items-start gap-3">
          <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-muted text-primary" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 5.5a2.5 2.5 0 0 1 2.5-2.5h2a2 2 0 0 1 2 1.7l.3 2.1a2 2 0 0 1-.6 1.7l-1.2 1.1a16 16 0 0 0 5.5 5.5l1.1-1.2a2 2 0 0 1 1.7-.6l2.1.3a2 2 0 0 1 1.7 2v2A2.5 2.5 0 0 1 18.5 20h-1C9.5 20 3 13.5 3 5.5v-1Z" />
            </svg>
          </span>
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-wide text-primary/80">{copy.info.phone}</h3>
            <p class="mt-1 text-sm text-muted-foreground">
              <a href={`tel:${CONTACT.phone.replace(/\s+/g, "")}`} class="hover:text-primary">
                {CONTACT.phone}
              </a>
            </p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-muted text-primary" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8">
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path stroke-linecap="round" stroke-linejoin="round" d="m4 7 8 6 8-6" />
            </svg>
          </span>
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-wide text-primary/80">{copy.info.email}</h3>
            <p class="mt-1 text-sm text-muted-foreground">
              <a href={`mailto:${CONTACT.email}`} class="hover:text-primary">
                {CONTACT.email}
              </a>
            </p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-muted text-primary" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21s7-5.2 7-11a7 7 0 1 0-14 0c0 5.8 7 11 7 11Z" />
              <circle cx="12" cy="10" r="2.5" />
            </svg>
          </span>
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-wide text-primary/80">{copy.info.location}</h3>
            <p class="mt-1 text-sm text-muted-foreground">{CONTACT.location[locale]}</p>
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>
