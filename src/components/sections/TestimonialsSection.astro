---
import { TESTIMONIALS } from "@/data/apartments";
import { getLocalizedText } from "@/types/content";
import type { LocaleCode } from "@/types/seo";

interface Props {
  locale: LocaleCode;
  title: string;
  subtitle: string;
}

const { locale, title, subtitle } = Astro.props;
---

<section class="section-shell bg-muted/40">
  <div class="page-shell">
    <h2 class="section-title">{title}</h2>
    <p class="section-subtitle">{subtitle}</p>

    <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-3">
      {TESTIMONIALS.map((testimonial) => (
        <article class="surface-card">
          <h3 class="text-lg font-semibold text-primary">{testimonial.author}</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
            {getLocalizedText(testimonial.text, locale)}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
