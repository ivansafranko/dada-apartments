---
interface Props {
  language: "hr" | "en";
  hotelId: string;
  currency: string;
  frameTitle: string;
  loadLabel: string;
  fallbackBookingUrl: string;
  fallbackCta: string;
}

const {
  language,
  hotelId,
  currency,
  frameTitle,
  loadLabel,
  fallbackBookingUrl,
  fallbackCta
} = Astro.props;
const src =
  `/booking-widget-embed?lang=${language}` +
  `&hotelId=${encodeURIComponent(hotelId)}` +
  `&currency=${encodeURIComponent(currency)}`;
---

<div class="booking-frame-shell">
  <p class="mb-3 text-sm text-muted-foreground">{loadLabel}</p>
  <iframe
    src={src}
    title={frameTitle}
    class="booking-embed-frame"
    loading="eager"
  ></iframe>
</div>

<div class="mt-4 flex justify-center">
  <a
    href={fallbackBookingUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="btn-accent"
  >
    {fallbackCta}
  </a>
</div>
