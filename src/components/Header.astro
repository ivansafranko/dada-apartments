---
export interface Props {
  isBooking?: boolean;
}

const { isBooking = false } = Astro.props;
const home = isBooking ? '/' : '#home';
const about = isBooking ? '/#about' : '#about';
const apartments = isBooking ? '/#apartments' : '#apartments';
const contact = isBooking ? '/#contact' : '#contact';
---

<header class="header">
  <div class="container">
    <div class="header-content">
      <div class="logo">
        <a href="/" aria-label="Početna stranica" data-translate-aria-label="home-link-label"><span class="logo-text" lang="hr">Apartmani Dada</span></a>
      </div>
      <nav class="navigation" aria-label="Glavna navigacija" data-translate-aria-label="primary-nav-label">
        <div class="nav-desktop">
          <a href={home} class:list={['nav-link', { active: !isBooking }]} data-translate="nav-home">Početna</a>
          <a href={apartments} class="nav-link" data-translate="nav-apartments">Apartmani</a>
          <a href={about} class="nav-link" data-translate="nav-about">O nama</a>
          <a href="/book-now/" class:list={['nav-link', 'nav-book', { active: isBooking }]} data-translate="nav-book">Rezervirajte online</a>
        </div>
        <div class="header-actions nav-desktop">
          <a href={contact} class="nav-link nav-cta" data-translate="nav-contact">Kontakt</a>
          <button class="language-toggle" id="languageToggle" type="button" aria-label="Prebaci na engleski" aria-pressed="false">
            <svg class="language-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm0 0c2.1-2.2 3.2-5.2 3.2-9S14.1 5.2 12 3m0 18c-2.1-2.2-3.2-5.2-3.2-9S9.9 5.2 12 3m-8.3 9h16.6" /></svg>
            <span class="lang-text">HR</span>
          </button>
        </div>

        <div class="nav-mobile">
          <div class="nav-mobile-row1">
            <div class="nav-mobile-actions">
              <button class="language-toggle" id="languageToggleMobile" type="button" aria-label="Prebaci na engleski" aria-pressed="false">
                <svg class="language-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm0 0c2.1-2.2 3.2-5.2 3.2-9S14.1 5.2 12 3m0 18c-2.1-2.2-3.2-5.2-3.2-9S9.9 5.2 12 3m-8.3 9h16.6" /></svg>
                <span class="lang-text">HR</span>
              </button>
              <button class="hamburger-menu" id="hamburgerMenu" type="button" aria-label="Otvori navigaciju" aria-expanded="false" aria-controls="mobileMenu">
                <span class="hamburger-line" aria-hidden="true"></span>
                <span class="hamburger-line" aria-hidden="true"></span>
                <span class="hamburger-line" aria-hidden="true"></span>
              </button>
            </div>
          </div>
        </div>

        <div class="mobile-menu" id="mobileMenu" aria-hidden="true">
          <a href={home} class="mobile-nav-link" data-translate="nav-home">Početna</a>
          <a href={apartments} class="mobile-nav-link" data-translate="nav-apartments">Apartmani</a>
          <a href={about} class="mobile-nav-link" data-translate="nav-about">O nama</a>
          <a href="/book-now/" class="mobile-nav-link mobile-nav-book" data-translate="nav-book">Rezervirajte online</a>
          <a href={contact} class="mobile-nav-link" data-translate="nav-contact">Kontakt</a>
        </div>
      </nav>
    </div>
  </div>
</header>
