---
export type IconName = 'arrow-up' | 'building' | 'check-circle' | 'mail' | 'map-pin' | 'phone' | 'trees' | 'waves';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg class={className} width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" aria-hidden="true" focusable="false">
  {name === 'arrow-up' && <><path d="M12 19V5" /><path d="m5 12 7-7 7 7" /></>}
  {name === 'building' && <><path d="M3 21h18" /><path d="M6 21V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v17" /><path d="M9 7h1" /><path d="M14 7h1" /><path d="M9 11h1" /><path d="M14 11h1" /><path d="M10 21v-5h4v5" /></>}
  {name === 'check-circle' && <><circle cx="12" cy="12" r="9" /><path d="m8.5 12 2.25 2.25 4.75-5" /></>}
  {name === 'mail' && <><rect width="18" height="14" x="3" y="5" rx="2" /><path d="m3 7 9 6 9-6" /></>}
  {name === 'map-pin' && <><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" /><circle cx="12" cy="10" r="2.5" /></>}
  {name === 'phone' && <path d="M21 16.4v3a1.8 1.8 0 0 1-2 1.8A17.8 17.8 0 0 1 3 5a1.8 1.8 0 0 1 1.8-2h3a1.8 1.8 0 0 1 1.8 1.5l.7 3.1a1.8 1.8 0 0 1-.5 1.7l-1.2 1.2a14.5 14.5 0 0 0 5 5l1.2-1.2a1.8 1.8 0 0 1 1.7-.5l3.1.7A1.8 1.8 0 0 1 21 16.4Z" />}
  {name === 'trees' && <><path d="M7 21v-3" /><path d="M17 21v-5" /><path d="M3 14h8L7 4l-4 10Z" /><path d="M12 16h9l-4.5-10L12 16Z" /></>}
  {name === 'waves' && <><path d="M2 12c2.2 2.2 4.4 2.2 6.6 0 2.2-2.2 4.4-2.2 6.6 0 2.2 2.2 4.4 2.2 6.6 0" /><path d="M2 17c2.2 2.2 4.4 2.2 6.6 0 2.2-2.2 4.4-2.2 6.6 0 2.2 2.2 4.4 2.2 6.6 0" /></>}
</svg>
