---
interface Props {
  brand: string;
  text: string;
  copyright: string;
  facebookUrl: string;
}

const { brand, text, copyright, facebookUrl } = Astro.props;
---

<footer class="border-t border-border bg-primary text-primary-foreground">
  <div class="page-shell py-10">
    <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
      <div class="space-y-2">
        <h2 class="text-xl font-semibold text-primary-foreground">{brand}</h2>
        <p class="max-w-2xl text-sm text-primary-foreground/90">{text}</p>
      </div>

      <a
        href={facebookUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Facebook"
        class="inline-flex min-h-11 min-w-11 items-center justify-center gap-2 rounded-full border border-primary-foreground/50 px-4 text-sm font-semibold text-primary-foreground hover:bg-primary-foreground/10"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
          <path d="M13.4 20v-7h2.3l.3-2.7h-2.6V8.5c0-.8.2-1.3 1.4-1.3h1.5V4.8c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8v1.8H8v2.7h2.4v7h3Z" />
        </svg>
        Facebook
      </a>
    </div>
    <p class="mt-8 text-xs text-primary-foreground/80">{copyright}</p>
  </div>
</footer>
